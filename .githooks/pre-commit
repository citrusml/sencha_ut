#!/bin/sh
# コミットしようとしている JPEG / PNG にメタデータ（位置情報・撮影日時など）が残っていないか確認する。
# 残っていたらコミットを止めて、消し方を表示する。
# 有効にするには、リポジトリで一度だけ: git config core.hooksPath .githooks

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT

found=0
IFS='
'
for f in $(git -c core.quotepath=off diff --cached --name-only --diff-filter=ACMR | grep -iE '\.(jpe?g|png)$'); do
    # 作業フォルダではなく、実際にコミットされる中身（ステージ済みの内容）を調べる
    git show ":$f" > "$tmp/img" || continue
    result=$(perl tools/strip_metadata.pl report "$tmp/img" | sed '1d')
    if [ "$result" != "    (none)" ]; then
        [ $found -eq 0 ] && echo "画像にメタデータが残っています。コミットを中止しました。" >&2
        found=1
        echo "  $f" >&2
        echo "$result" | sed 's/^    /      /' >&2
    fi
done

if [ $found -ne 0 ]; then
    echo "" >&2
    echo "消すには: perl tools/strip_metadata.pl strip <ファイル>  → git add し直してからコミット" >&2
    exit 1
fi
exit 0
